# Modelo de configuração. Copie para secrets.toml localmente e substitua os valores.
# NÃO coloque secrets.toml real no GitHub.
[admin]
usuario = "admin"
# Gere salt/hash com: python scripts/gerar_hash_senha.py
admin_salt = "SUBSTITUA_PELO_SALT_GERADO"
admin_hash = "SUBSTITUA_PELO_HASH_GERADO"

[nominatim]
user_agent = "MESAFARTAI/1.0 (contato: seu-email@exemplo.com)"
